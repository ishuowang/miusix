{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build --workspace @miusix/web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/ios",
      "destination": "/ios/index.html"
    },
    {
      "source": "/ios/",
      "destination": "/ios/index.html"
    }
  ]
}
